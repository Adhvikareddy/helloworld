# Q-SENTINEL Environment Configuration Example

# API Connection
QSENTINEL_API_URL=http://localhost:8000
QSENTINEL_API_HOST=0.0.0.0
QSENTINEL_API_PORT=8000

# Ledger Storage
QSENTINEL_DB_PATH=data/ledger.db

# Attack Harness Defaults
QSENTINEL_DEFAULT_SHOTS=1024
QSENTINEL_DEFAULT_SEED=42
QSENTINEL_FORGERY_B_POPULATION=20
QSENTINEL_REPEAT_COUNT=5

# Rate Limiting
QSENTINEL_RATE_LIMIT_ENABLED=true
QSENTINEL_RATE_LIMIT_REQUESTS=100
QSENTINEL_RATE_LIMIT_WINDOW=60
